# Copy this file to .env (which is git-ignored) and fill in your values.
# This connects the generate_chart.py script to your local n8n database.

# GET webhook URL for fetching the current score
N8N_SCORE_URL=http://localhost:5678/webhook/REPLACE-WITH-YOUR-GET-WEBHOOK-PATH

# The password (X-Api-Key) you set in the n8n Header Auth credential
N8N_TOKEN=REPLACE-WITH-YOUR-PASSWORD